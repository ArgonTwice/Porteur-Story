; Porter Story (code DS-Manager). Godot 4.7.2, rendu Compatibility.
config_version=5

[application]

config/name="Porter Story"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Clock="*res://src/autoload/clock.gd"
DataDB="*res://src/autoload/data_db.gd"
I18n="*res://src/autoload/i18n.gd"
SaveGame="*res://src/autoload/save_game.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[internationalization]

locale/fallback="fr"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
